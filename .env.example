# =========================================================================
# Resume Reviewer & Feedback AI Platform — Root Environment Example
# Copy this file to .env and configure for your local/production environment
# NEVER commit real API keys or credentials to version control.
# =========================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000

# Server Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key

# Feature Flags & AI Providers
ENABLE_SEMANTIC_MATCHING=true
ENABLE_RAG=true
ENABLE_LLM_FEEDBACK=true
LLM_PROVIDER=rule_based
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

